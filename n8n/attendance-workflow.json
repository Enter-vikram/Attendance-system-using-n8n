{
  "name": "WhatsApp Smart Attendance",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-incoming",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "WhatsApp Webhook (Meta)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body?.object }}",
              "operation": "equals",
              "value2": "whatsapp_business_account"
            }
          ]
        }
      },
      "id": "check-whatsapp",
      "name": "Is WhatsApp Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract message details from WhatsApp Cloud API payload\nconst body = $input.first().json.body;\n\ntry {\n  const entry = body.entry?.[0];\n  const change = entry?.changes?.[0];\n  const value = change?.value;\n  const message = value?.messages?.[0];\n  const contact = value?.contacts?.[0];\n\n  if (!message || message.type !== 'text') {\n    return [{ json: { skip: true } }];\n  }\n\n  return [{\n    json: {\n      phone: message.from,\n      message: message.text.body,\n      name: contact?.profile?.name || 'Employee',\n      messageId: message.id,\n      timestamp: message.timestamp\n    }\n  }];\n} catch (e) {\n  return [{ json: { skip: true, error: e.message } }];\n}"
      },
      "id": "extract-message",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 240]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.skip }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-skip",
      "name": "Valid Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 240]
    },
    {
      "parameters": {
        "url": "={{ $env.ATTENDANCE_BACKEND_URL }}/api/whatsapp/webhook",
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, message: $json.message }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "call-backend",
      "name": "Call Attendance Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({\n  messaging_product: 'whatsapp',\n  to: $('extract-message').first().json.phone,\n  type: 'text',\n  text: { body: $('call-backend').first().json.reply }\n}) }}",
        "options": {}
      },
      "id": "send-whatsapp-reply",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\" }"
      },
      "id": "respond-200",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ignored\" }"
      },
      "id": "respond-ignore",
      "name": "Respond Ignored",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 400]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-incoming",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-verify",
      "name": "WhatsApp Verification (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 520]
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp webhook verification\nconst query = $input.first().json.query;\nconst VERIFY_TOKEN = process.env.WHATSAPP_VERIFY_TOKEN || 'attendance_verify_2024';\n\nif (query['hub.mode'] === 'subscribe' && query['hub.verify_token'] === VERIFY_TOKEN) {\n  return [{ json: { challenge: query['hub.challenge'], valid: true } }];\n}\nreturn [{ json: { valid: false } }];"
      },
      "id": "verify-token",
      "name": "Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 520]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}"
      },
      "id": "respond-challenge",
      "name": "Respond Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 520]
    }
  ],
  "connections": {
    "WhatsApp Webhook (Meta)": {
      "main": [[{ "node": "Is WhatsApp Event?", "type": "main", "index": 0 }]]
    },
    "Is WhatsApp Event?": {
      "main": [
        [{ "node": "Extract Message", "type": "main", "index": 0 }],
        [{ "node": "Respond Ignored", "type": "main", "index": 0 }]
      ]
    },
    "Extract Message": {
      "main": [[{ "node": "Valid Message?", "type": "main", "index": 0 }]]
    },
    "Valid Message?": {
      "main": [
        [{ "node": "Call Attendance Backend", "type": "main", "index": 0 }],
        [{ "node": "Respond Ignored", "type": "main", "index": 0 }]
      ]
    },
    "Call Attendance Backend": {
      "main": [[{ "node": "Send WhatsApp Reply", "type": "main", "index": 0 }]]
    },
    "Send WhatsApp Reply": {
      "main": [[{ "node": "Respond 200 OK", "type": "main", "index": 0 }]]
    },
    "WhatsApp Verification (GET)": {
      "main": [[{ "node": "Verify Token", "type": "main", "index": 0 }]]
    },
    "Verify Token": {
      "main": [[{ "node": "Respond Challenge", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
