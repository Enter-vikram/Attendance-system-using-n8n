# Smart Attendance System - Environment Configuration
# Copy this to .env and fill in your values

# Your public server URL (used in WhatsApp check-in links)
# Local: http://localhost:4000  |  Production: https://your-domain.com
BASE_URL=http://localhost:4000

# n8n settings
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678

# WhatsApp Cloud API credentials (from Meta Developer Portal)
WHATSAPP_TOKEN=YOUR_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_ID=YOUR_PHONE_NUMBER_ID
