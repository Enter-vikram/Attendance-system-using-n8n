# Smart Attendance System - Environment Configuration
# Copy this to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — single connection string (Railway / Render / Heroku inject this automatically)
# When DATABASE_URL is set it takes full precedence; DB_* vars below are ignored.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B — individual vars (local Docker Compose only)
DB_NAME=attendance
DB_USER=admin
DB_PASSWORD=CHANGE_ME_strong_db_password

# ── Backend ───────────────────────────────────────────────────────────────────
# Public URL of your server (used in WhatsApp check-in links)
# Local: http://localhost:4000  |  Production: https://your-domain.com
BASE_URL=http://localhost:4000

# Password for the admin dashboard login page
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Random secret for signing session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_random_96char_hex_string

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_strong_n8n_password

# ── WhatsApp Cloud API (from Meta Developer Portal) ───────────────────────────
WHATSAPP_TOKEN=YOUR_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_ID=YOUR_PHONE_NUMBER_ID
# Token you set in Meta webhook verification (must match what you enter in Meta portal)
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN

# Set to true ONLY when serving over HTTPS (nginx/reverse proxy with TLS)
# Leave false for local HTTP development
COOKIE_SECURE=false

# ── Optional ──────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
